# Public website runtime. Joining and membership management use hosted Stripe links.
# No authentication, payment, email, or attendee-provider credentials are required.
# Keep real secrets outside Git; .env.build intentionally contains no assignments.
# Production readiness requires a private, trimmed, header-safe token (32+ characters).
# Sentry is optional; configure both DSNs together when enabling it.
# SENTRY_* upload controls belong only to the build; pass the token as a BuildKit secret.

NODE_ENV=development
NITRO_PRESET=node-server
NUXT_PUBLIC_APP_NAME="Working Class Unity"
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_DATABASE_URL=file:./data/app.db
NUXT_READINESS_TOKEN=local-readiness-token-change-me-32-chars
NUXT_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
NUXT_SENTRY_ENVIRONMENT=development
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
NUXT_SENTRY_RELEASE=
NUXT_PUBLIC_SENTRY_RELEASE=
NUXT_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_OBSERVABILITY_TEST_TOKEN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
SENTRY_URL=
SENTRY_UPLOAD_CACHE_BUST=disabled
