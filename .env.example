# Build/platform controls (not application runtimeConfig)
NODE_ENV=development
NITRO_PRESET=node-server

# Public application runtime (omit app name for its default; when set it must be nonblank and trimmed)
NUXT_PUBLIC_APP_NAME="Working Class Unity"
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Required core server runtime
NUXT_DATABASE_URL=file:./data/app.db
# Explicit local-only value; production rejects it. App-owned policy: 32+ trimmed
# header-safe ASCII characters, starting with a letter.
NUXT_READINESS_TOKEN=local-readiness-token-change-me-32-chars
# Explicit local-only value; production rejects it. Auth URL must equal the app URL origin.
NUXT_BETTER_AUTH_SECRET=local-development-secret-change-me-32-chars
NUXT_BETTER_AUTH_URL=http://localhost:3000

# Transactional email is core because passwordless authentication depends on it.
# Capture writes private JSON messages locally without network delivery. CI=true may
# permit capture for a NODE_ENV=production test only when both app/auth origins are
# loopback; never select capture in a deployed runtime.
NUXT_EMAIL_TRANSPORT=capture
NUXT_EMAIL_FROM="Working Class Unity <no-reply@example.test>"
NUXT_EMAIL_CAPTURE_DIRECTORY=./data/email-capture
# Required only when NUXT_EMAIL_TRANSPORT=resend. Keep this server-only.
NUXT_EMAIL_RESEND_API_KEY=

# Twilio Verify powers passwordless U.S. phone confirmation and login. Use a
# restricted API key in production; these local placeholders cannot send SMS.
NUXT_TWILIO_VERIFY_API_KEY_SID=SK00000000000000000000000000000000
NUXT_TWILIO_VERIFY_API_KEY_SECRET=local-development-twilio-secret-change-me
NUXT_TWILIO_VERIFY_SERVICE_SID=VA00000000000000000000000000000000

# Billing is always active. These local placeholders satisfy startup validation
# but cannot authenticate with Stripe.
NUXT_STRIPE_SECRET_KEY=rk_test_local_development_only
NUXT_STRIPE_WEBHOOK_SECRET=whsec_local_development_only
NUXT_STRIPE_PORTAL_CONFIGURATION_ID=bpc_local_development_only
NUXT_STRIPE_MEMBERSHIP_DUES10_PRICE_ID=price_local_membership_dues_10
NUXT_STRIPE_SOLIDARITY_DUES27_PRICE_ID=price_local_solidarity_dues_27

# Files, AI, File Search, and Web Search are excluded from the basic release.
# Do not configure application R2 or OpenAI values.

# Turnstile is always active. Cloudflare's official dummy keys test provider
# plumbing, not the app's strict action/hostname journey.
NUXT_CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Observability runtime (private/public DSNs are required in production)
NUXT_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
NUXT_SENTRY_ENVIRONMENT=development
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
NUXT_SENTRY_RELEASE=
NUXT_PUBLIC_SENTRY_RELEASE=
NUXT_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_OBSERVABILITY_TEST_TOKEN=

# Sentry source-map upload controls are build-only and are never runtime readiness inputs.
# Docker must provide the token through a BuildKit secret, not ARG or ENV.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
SENTRY_URL=
SENTRY_UPLOAD_CACHE_BUST=disabled
