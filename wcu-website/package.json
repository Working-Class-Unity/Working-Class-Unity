{
  "name": "wcu-website",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "nuxt prepare && eslint --no-error-on-unmatched-pattern server app/features shared tests/unit eslint.config.mjs vitest.config.ts",
    "lint:all": "nuxt prepare && eslint .",
    "typecheck": "nuxt typecheck",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "quality": "npm run lint && npm run typecheck && npm run test:unit",
    "audit:prod": "node scripts/npm-audit-gate.mjs",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts"
  },
  "dependencies": {
    "@formbricks/js": "^4.2.1",
    "@nuxt/fonts": "^0.12.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "^0.13.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.5.5",
    "nuxt": "^4.2.1",
    "nuxt-schema-org": "^5.0.9",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@nuxt/eslint": "^1.13.0",
    "@nuxt/test-utils": "^3.23.0",
    "@nuxtjs/i18n": "^10.2.1",
    "@playwright/test": "^1.58.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.2",
    "happy-dom": "^20.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.4"
  }
}
