# PocketBase backend
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SERVICE_EMAIL=service-account@example.com
POCKETBASE_SERVICE_PASSWORD=replace-with-strong-password
POCKETBASE_AUTH_COLLECTION=users
POCKETBASE_MAGIC_LINK_COLLECTION=auth_magic_links
POCKETBASE_MAGIC_LINK_TTL_MINUTES=20
POCKETBASE_MEMBER_PROFILE_COLLECTION=member_profiles
POCKETBASE_DUES_RECORD_COLLECTION=dues_records
POCKETBASE_MEMBER_PROFILE_USER_FIELD=userId
POCKETBASE_DUES_RECORD_USER_FIELD=userId
POCKETBASE_BUILDINGS_COLLECTION=buildings
POCKETBASE_OUTREACH_COLLECTION=outreach_interactions
POCKETBASE_OUTREACH_DATE_FIELD=occurredAt
POCKETBASE_OUTREACH_BUILDING_FIELD=buildingId
POCKETBASE_FINANCE_INCOME_COLLECTION=dues_records
POCKETBASE_FINANCE_EXPENSE_COLLECTION=expense_records
POCKETBASE_FINANCE_INCOME_AMOUNT_FIELD=amountCents
POCKETBASE_FINANCE_EXPENSE_AMOUNT_FIELD=amountCents
POCKETBASE_FINANCE_INCOME_DATE_FIELD=paidAt
POCKETBASE_FINANCE_EXPENSE_DATE_FIELD=spentAt
POCKETBASE_USER_ROLE_FIELD=role
POCKETBASE_USER_DUES_PAID_THROUGH_FIELD=duesPaidThrough

# Cookie session for app auth (set to a long random string)
AUTH_SESSION_SECRET=replace-with-64-char-random-secret
AUTH_SESSION_TTL_SECONDS=1209600

# Email delivery for passwordless magic links
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Working Class Unity <auth@workingclassunity.com>
AUTH_MAGIC_LINK_ORIGIN=http://localhost:3000

# Existing client-side integrations
NUXT_PUBLIC_FORMBRICKS_ENVIRONMENT_ID=cminsehli0009o8015hjuzkuz
NUXT_PUBLIC_FORMBRICKS_APP_URL=https://form.workingclassunity.com
