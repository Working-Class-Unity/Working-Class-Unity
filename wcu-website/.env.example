# PocketBase backend
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SERVICE_EMAIL=service-account@example.com
POCKETBASE_SERVICE_PASSWORD=replace-with-strong-password

# Cookie session for app auth (set to a long random string)
AUTH_SESSION_SECRET=replace-with-64-char-random-secret
AUTH_SESSION_TTL_SECONDS=1209600

# Email delivery for passwordless magic links
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Working Class Unity <auth@workingclassunity.com>
AUTH_MAGIC_LINK_ORIGIN=http://localhost:3000

# Existing client-side integrations
NUXT_PUBLIC_FORMBRICKS_ENVIRONMENT_ID=cminsehli0009o8015hjuzkuz
NUXT_PUBLIC_FORMBRICKS_APP_URL=https://form.workingclassunity.com
