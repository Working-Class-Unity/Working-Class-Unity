# Docker reads this file before sending the build context. Keep the context
# deny-by-default and re-include only inputs required to install and build the
# production application.
**

!.env.build
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

!scripts/
scripts/**
!scripts/run-pnpm.mjs
!scripts/toolchain-contract.mjs

!apps/
apps/**
!apps/web/
apps/web/**
!apps/web/package.json
!apps/web/nuxt.config.ts
!apps/web/sentry.client.config.ts
!apps/web/sentry.server.config.ts
!apps/web/worker-sentry.server.config.ts
!apps/web/source-map-cleanup.mjs
!apps/web/tsconfig.json

!apps/web/app/
!apps/web/app/**
!apps/web/i18n/
!apps/web/i18n/**
!apps/web/public/
!apps/web/public/**
!apps/web/server/
!apps/web/server/**
!apps/web/shared/
!apps/web/shared/**

# Re-apply local-secret, state, and generated-output exclusions inside every
# allowlisted source directory. The final exception retains only the committed,
# assignment-free build environment file at the context root.
**/.env
**/.env.*
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
**/*.sqlite3
**/*.sqlite3-shm
**/*.sqlite3-wal
**/*-journal
**/*.log
**/*.key
**/*.p12
**/*.pfx
**/*.pem
**/.DS_Store
**/.aws
**/.aws/**
**/.git
**/.git/**
**/.dex
**/.dex/**
**/.idea
**/.idea/**
**/.nuxt
**/.nuxt/**
**/.npmrc
**/.output
**/.output/**
**/.ssh
**/.ssh/**
**/.vscode
**/.vscode/**
**/backups
**/backups/**
**/coverage
**/coverage/**
**/data
**/data/**
**/logs
**/logs/**
**/node_modules
**/node_modules/**
!.env.build
