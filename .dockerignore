# Docker reads this file before sending the build context. Keep the context
# deny-by-default and re-include only inputs required to install and build the
# production application.
**

!.env.build
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

!scripts/
scripts/**
!scripts/run-pnpm.mjs
!scripts/toolchain-contract.mjs
!scripts/generate-color-tokens.mjs
!scripts/generate-hero-assets.mjs
!scripts/import-stripe-membership.ts

!nuxt.config.ts
!sentry.client.config.ts
!sentry.server.config.ts
!worker-sentry.server.config.ts
!source-map-cleanup.mjs
!tsconfig.json

!app/
!app/**
!i18n/
!i18n/**
!public/
!public/**
!server/
!server/**
!shared/
!shared/**

# Re-apply local-secret, state, and generated-output exclusions inside every
# allowlisted source directory. The final exception retains only the committed,
# assignment-free build environment file at the context root.
**/.env
**/.env.*
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
**/*.sqlite3
**/*.sqlite3-shm
**/*.sqlite3-wal
**/*-journal
**/*.log
**/*.key
**/*.p12
**/*.pfx
**/*.pem
**/.DS_Store
**/.aws
**/.aws/**
**/.git
**/.git/**
**/.dex
**/.dex/**
**/.idea
**/.idea/**
**/.nuxt
**/.nuxt/**
**/.npmrc
**/.output
**/.output/**
**/.ssh
**/.ssh/**
**/.vscode
**/.vscode/**
**/backups
**/backups/**
**/coverage
**/coverage/**
**/data
**/data/**
**/logs
**/logs/**
**/node_modules
**/node_modules/**
!.env.build
