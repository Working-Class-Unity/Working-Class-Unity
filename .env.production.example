# Mirror runtime values in Coolify. Supply build-only Sentry values only to the build step.
# Leave real secrets out of git and do not expose private values as Docker build arguments.

# Deployment controls (not application runtimeConfig)
NODE_ENV=production
NITRO_PRESET=node-server
# Public application runtime (omit app name for its default; when set it must be nonblank and trimmed)
NUXT_PUBLIC_APP_NAME="Working Class Unity"
NUXT_PUBLIC_APP_URL=

# Required core server runtime
NUXT_DATABASE_URL=file:/app/data/app.db
# App-owned policy: generate a private token with `printf 'ready-'; openssl rand -hex 32`.
NUXT_READINESS_TOKEN=
# Generate a 32+ character high-entropy value; auth URL must equal the app URL origin.
NUXT_BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_URL=

# Transactional email is core because passwordless authentication depends on it.
# Production uses Resend. Capture is limited to CI-controlled production-mode tests
# whose app and auth origins are both loopback.
NUXT_EMAIL_TRANSPORT=resend
NUXT_EMAIL_FROM=
NUXT_EMAIL_CAPTURE_DIRECTORY=
NUXT_EMAIL_RESEND_API_KEY=

# Twilio Verify powers passwordless U.S. phone confirmation and login. Use a
# restricted API key and keep its secret server-only.
NUXT_TWILIO_VERIFY_API_KEY_SID=
NUXT_TWILIO_VERIFY_API_KEY_SECRET=
NUXT_TWILIO_VERIFY_SERVICE_SID=

# Billing is always active; NUXT_STRIPE_SECRET_KEY must be a restricted rk_live_* key.
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_PORTAL_CONFIGURATION_ID=
NUXT_STRIPE_MEMBERSHIP_DUES10_PRICE_ID=
NUXT_STRIPE_SOLIDARITY_DUES27_PRICE_ID=

# Files, AI, File Search, and Web Search are excluded from the basic release.
# Do not configure application R2 or OpenAI values; Compose clears them for every role.

# Turnstile is always active; use real keys restricted to the deployed hostname, never Cloudflare dummy test keys.
NUXT_CLOUDFLARE_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Observability runtime (private/public DSNs are required in production)
NUXT_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
NUXT_SENTRY_ENVIRONMENT=production
NUXT_PUBLIC_SENTRY_ENVIRONMENT=production
NUXT_SENTRY_RELEASE=
NUXT_PUBLIC_SENTRY_RELEASE=
NUXT_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_OBSERVABILITY_TEST_TOKEN=

# Private SQLite backup operator. Provide all five values Runtime-only and
# Build-disabled. Compose refuses to render when any value is absent, blanks them
# outside the runner, and has the runner validate them before becoming stable.
# Never define WCU_CLEARED_ENVIRONMENT; Compose uses that reserved unset name to
# prevent Coolify's shared environment from refilling intentionally blank values.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# Sentry source-map upload controls are build-only and are never runtime readiness inputs.
# In Coolify, configure the token as a Docker Build Secret; never as a normal variable.
# The non-secret upload controls below are build arguments when Observability is enabled.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
SENTRY_URL=
SENTRY_UPLOAD_CACHE_BUST=disabled
