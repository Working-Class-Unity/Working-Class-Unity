# Mirror runtime values in Coolify. Supply build-only Sentry values only to the build step.
# Leave real secrets out of git and do not expose private values as Docker build arguments.

# Deployment controls (not application runtimeConfig)
NODE_ENV=production
NITRO_PRESET=node-server
# Optional Compose capabilities. Persistent baseline staging/production sets this to backup.
COMPOSE_PROFILES=

# Public application runtime (omit app name for its default; when set it must be nonblank and trimmed)
NUXT_PUBLIC_APP_NAME="SmallWiseLabs Base App"
NUXT_PUBLIC_APP_URL=

# Required core server runtime
NUXT_DATABASE_URL=file:/app/data/app.db
# App-owned policy: generate a private token with `printf 'ready-'; openssl rand -hex 32`.
NUXT_READINESS_TOKEN=
# Generate a 32+ character high-entropy value; auth URL must equal the app URL origin.
NUXT_BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_URL=

# Google is optional. When true, both credentials are required before startup.
NUXT_SOCIAL_PROVIDERS_GOOGLE_ENABLED=false
NUXT_SOCIAL_PROVIDERS_GOOGLE_CLIENT_ID=
NUXT_SOCIAL_PROVIDERS_GOOGLE_CLIENT_SECRET=

# Transactional email is core because passwordless authentication depends on it.
# Production uses authenticated SMTP with TLS; capture is rejected. Do not set CI
# in a deployed runtime because CI=true is reserved for production-mode test processes.
NUXT_EMAIL_TRANSPORT=smtp
NUXT_EMAIL_FROM=
NUXT_EMAIL_CAPTURE_DIRECTORY=
NUXT_EMAIL_SMTP_HOST=
NUXT_EMAIL_SMTP_PORT=
# Exactly tls (TLS on connect) or starttls (a required STARTTLS upgrade).
NUXT_EMAIL_SMTP_SECURITY=
NUXT_EMAIL_SMTP_USERNAME=
NUXT_EMAIL_SMTP_PASSWORD=

# Every runtime module flag is explicit and must be lowercase true or false.
# Billing and Files require Jobs enabled. When Jobs is false, the supervised worker stays inert.
NUXT_MODULES_BILLING_ENABLED=false
NUXT_MODULES_FILES_ENABLED=false
NUXT_MODULES_AI_ENABLED=false
NUXT_MODULES_TURNSTILE_ENABLED=false
NUXT_MODULES_OBSERVABILITY_ENABLED=false
NUXT_MODULES_JOBS_ENABLED=false

# Billing (required only when Billing is enabled; NUXT_STRIPE_SECRET_KEY must be a restricted rk_live_* key)
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_PORTAL_CONFIGURATION_ID=
NUXT_STRIPE_PERSONAL_WEEKLY_PRICE_ID=
NUXT_STRIPE_PERSONAL_MONTHLY_PRICE_ID=
NUXT_STRIPE_PERSONAL_ANNUAL_PRICE_ID=
NUXT_STRIPE_FAMILY_MONTHLY_PRICE_ID=
NUXT_STRIPE_FAMILY_ANNUAL_PRICE_ID=

# Required only when Files uses R2; copy the 32-character lowercase hex account ID.
NUXT_CLOUDFLARE_ACCOUNT_ID=

# Files: local persists under /app/data/objects; r2 requires the shared account id and every R2 value.
# Use the exact HTTPS account/jurisdiction endpoint documented in docs/cloudflare.md, never a custom domain.
NUXT_FILES_DRIVER=
NUXT_CLOUDFLARE_R2_BUCKET=
NUXT_CLOUDFLARE_R2_ENDPOINT=
NUXT_CLOUDFLARE_R2_ACCESS_KEY_ID=
NUXT_CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# OpenAI (required only when AI is enabled; use an isolated project service-account key).
# File Search and Web Search are subordinate capabilities. Keep both false for
# ordinary AI. Web Search additionally requires a comma-separated allowlist of
# 1-100 canonical lowercase DNS hostnames with no parent/subdomain overlap.
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_PROJECT_ID=
NUXT_OPENAI_MODEL=
NUXT_OPENAI_FILE_SEARCH_ENABLED=false
NUXT_OPENAI_FILE_SEARCH_VECTOR_STORE_ID=
NUXT_OPENAI_WEB_SEARCH_ENABLED=false
NUXT_OPENAI_WEB_SEARCH_ALLOWED_DOMAINS=

# Turnstile (required only when enabled; use real keys restricted to the deployed hostname, never Cloudflare dummy test keys)
NUXT_CLOUDFLARE_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Observability runtime (private/public DSNs required only when observability is enabled)
NUXT_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
NUXT_SENTRY_ENVIRONMENT=production
NUXT_PUBLIC_SENTRY_ENVIRONMENT=production
NUXT_SENTRY_RELEASE=
NUXT_PUBLIC_SENTRY_RELEASE=
NUXT_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_OBSERVABILITY_TEST_TOKEN=

# Optional private SQLite backup operator. Set COMPOSE_PROFILES=backup at
# Coolify build and runtime, then provide all five values Runtime-only and
# Build-disabled. Compose blanks them outside the runner; the runner validates
# them before becoming stable.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# Sentry source-map upload controls are build-only and are never runtime readiness inputs.
# In Coolify, configure the token as a Docker Build Secret; never as a normal variable.
# The non-secret upload controls below are build arguments when Observability is enabled.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
SENTRY_URL=
SENTRY_UPLOAD_CACHE_BUST=disabled
