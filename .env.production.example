# Public website runtime. Joining and membership management use hosted Stripe links.
# The public web process needs no authentication or payment credentials.
# Keep real secrets outside Git; .env.build intentionally contains no assignments.
# Production readiness requires a private, trimmed, header-safe token (32+ characters).
# Sentry is optional; configure both DSNs together when enabling it.
# SENTRY_* upload controls belong only to the build; pass the token as a BuildKit secret.

# BACKUP_R2_* values belong only to the private backup runner.
# Keep WCU_CLEARED_ENVIRONMENT unset so Compose isolates these credentials.

NODE_ENV=production
NITRO_PRESET=node-server
NUXT_PUBLIC_APP_NAME="Working Class Unity"
NUXT_PUBLIC_APP_URL=
NUXT_DATABASE_URL=file:/app/data/app.db
NUXT_READINESS_TOKEN=
NUXT_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
NUXT_SENTRY_ENVIRONMENT=production
NUXT_PUBLIC_SENTRY_ENVIRONMENT=production
NUXT_SENTRY_RELEASE=
NUXT_PUBLIC_SENTRY_RELEASE=
NUXT_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NUXT_OBSERVABILITY_TEST_TOKEN=
# Used by the scheduled sync command. Resend's sender must be on a verified domain.
EVENT_SYNC_COOKIES_PATH=/app/data/solidarity/cookies.json
EVENT_SYNC_RESEND_API_KEY=
EVENT_SYNC_ALERT_FROM=
EVENT_SYNC_ALERT_TO=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
SENTRY_URL=
SENTRY_UPLOAD_CACHE_BUST=disabled
