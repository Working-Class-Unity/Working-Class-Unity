{
  "name": "@smallwiselabs/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build --dotenv ../../.env.build",
    "postbuild": "node server/build-worker.mjs && node source-map-cleanup.mjs",
    "start": "node --import ./.output/server/sentry.server.config.mjs .output/server/index.mjs",
    "preview": "nuxt preview",
    "worker": "node --import tsx --import ./worker-sentry.server.config.ts server/worker.ts",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node server/db/run-maintenance-migration.mjs",
    "db:studio": "drizzle-kit studio",
    "db:backup": "node server/db/backup.mjs",
    "db:migrate:check": "tsx server/db/migration-check.ts",
    "lint": "eslint .",
    "stylelint": "stylelint \"app/**/*.{css,vue}\"",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1045.0",
    "@aws-sdk/s3-request-presigner": "3.1045.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@nuxtjs/i18n": "10.5.0",
    "@sentry/nuxt": "10.64.0",
    "better-auth": "1.6.23",
    "better-sqlite3": "12.10.0",
    "destr": "2.0.5",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "h3": "1.15.11",
    "nodemailer": "9.0.3",
    "nuxt": "4.5.0",
    "nuxt-security": "2.6.0",
    "openai": "6.47.0",
    "reka-ui": "2.10.1",
    "stripe": "22.3.1",
    "vue": "3.5.39",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "10.3.0",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "1.0.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "vue-tsc": "3.2.9"
  },
  "engines": {
    "node": ">=24.11.0 <25.0.0"
  }
}
