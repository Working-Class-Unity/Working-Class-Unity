{
  "name": "working-class-unity",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/run-pnpm.mjs install --frozen-lockfile",
    "pnpm": "node scripts/run-pnpm.mjs",
    "verify:pinned": "node scripts/run-pnpm.mjs run verify",
    "format:check": "node scripts/format-changed.mjs",
    "dev": "node --env-file-if-exists=.env scripts/run-pnpm.mjs exec nuxt dev",
    "build": "node scripts/run-pnpm.mjs exec nuxt build --dotenv .env.build",
    "postbuild": "node server/build-worker.mjs && node source-map-cleanup.mjs",
    "start": "node --env-file-if-exists=.env --import ./.output/server/sentry.server.config.mjs .output/server/index.mjs",
    "preview": "node --env-file-if-exists=.env scripts/run-pnpm.mjs exec nuxt preview",
    "worker": "node --env-file-if-exists=.env --import tsx --import ./worker-sentry.server.config.ts server/worker.ts",
    "postinstall": "node scripts/run-pnpm.mjs exec nuxt prepare",
    "db:generate": "node --env-file-if-exists=.env scripts/run-pnpm.mjs exec drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env server/db/run-maintenance-migration.mjs",
    "db:studio": "node --env-file-if-exists=.env scripts/run-pnpm.mjs exec drizzle-kit studio",
    "db:backup": "node --env-file-if-exists=.env server/db/backup.mjs",
    "db:migrate:check": "node --env-file-if-exists=.env scripts/run-pnpm.mjs exec tsx server/db/migration-check.ts",
    "doctor": "node scripts/doctor.mjs",
    "check:toolchain": "node --test scripts/toolchain-contract.test.mjs",
    "test:tooling": "node --test scripts/ci-browser-helpers.test.mjs scripts/ci-container-build.test.mjs scripts/ci-container-health.test.mjs scripts/compose-deployment.test.mjs scripts/container-maintenance.test.mjs scripts/deployment-smoke.test.mjs scripts/format-changed.test.mjs scripts/isolated-api-smoke.test.mjs scripts/off-host-backup.test.mjs scripts/openai-corpus.test.mjs scripts/playwright-foundation-reporter.test.mjs scripts/vitest-policy-reporter.test.mjs",
    "check:supply-chain": "node --test scripts/supply-chain-policy.test.mjs && node scripts/supply-chain-policy.mjs",
    "scan:supply-chain": "node scripts/supply-chain-scan.mjs all",
    "test:framework-security": "node --test scripts/framework-security-helpers.test.mjs && node scripts/framework-security-smoke.mjs",
    "ops:readiness": "node scripts/run-pnpm.mjs exec tsx scripts/production-readiness.ts",
    "ops:readiness:strict": "node scripts/run-pnpm.mjs exec tsx scripts/production-readiness.ts --strict",
    "ops:smoke": "node scripts/deployment-smoke.mjs",
    "openai:corpus": "node scripts/openai-corpus.mjs",
    "api:smoke": "node scripts/isolated-api-smoke.mjs",
    "lint": "node scripts/run-pnpm.mjs exec eslint . --ignore-pattern \"scripts/**\" --ignore-pattern playwright.config.mjs",
    "stylelint": "node scripts/run-pnpm.mjs exec stylelint \"app/**/*.{css,vue}\"",
    "typecheck": "node scripts/run-pnpm.mjs exec nuxt typecheck",
    "test": "node scripts/run-pnpm.mjs exec vitest run",
    "test:browser": "node scripts/ci-browser-smoke.mjs",
    "test:container-build": "node scripts/ci-container-build.mjs",
    "test:container-health": "node scripts/ci-container-health.mjs",
    "test:runtime": "node scripts/ci-runtime-smoke.mjs",
    "check": "pnpm run format:check && pnpm run doctor && pnpm run check:toolchain && pnpm run test:tooling && pnpm run check:supply-chain && pnpm run test:framework-security && pnpm run lint && pnpm run stylelint && pnpm run db:migrate:check && pnpm run typecheck && pnpm run test",
    "verify": "pnpm run check && pnpm run scan:supply-chain && pnpm run build && pnpm run test:runtime && pnpm run test:browser && pnpm run api:smoke && pnpm run test:container-build && pnpm run test:container-health"
  },
  "engines": {
    "node": ">=24.11.0 <25.0.0",
    "pnpm": "11.1.2"
  },
  "browserslist": [
    "baseline widely available on 2025-05-01"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "3.1045.0",
    "@aws-sdk/s3-request-presigner": "3.1045.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@nuxtjs/i18n": "10.5.0",
    "@sentry/nuxt": "10.64.0",
    "better-auth": "1.6.23",
    "better-sqlite3": "12.10.0",
    "destr": "2.0.5",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "h3": "1.15.11",
    "resend": "6.18.1",
    "nuxt": "4.5.0",
    "nuxt-security": "2.6.0",
    "openai": "6.47.0",
    "reka-ui": "2.10.1",
    "stripe": "22.3.1",
    "vue": "3.5.39",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@nuxt/eslint": "1.16.0",
    "@playwright/test": "1.61.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "10.3.0",
    "happy-dom": "20.11.1",
    "prettier": "3.9.5",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "1.0.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "vue-tsc": "3.2.9",
    "yaml": "2.9.0"
  }
}
